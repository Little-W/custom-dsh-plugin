{
  "name": "@agent-studio/plugin-opencode-provider",
  "version": "0.1.15",
  "type": "module",
  "scripts": {
    "test:recovery": "node --test provider-failure.test.js provider-retry.integration.test.js openai-web-search.test.js"
  },
  "description": "连接并管理 OpenCode 提供的 AI 模型；Claude 模型也可通过工作台内置的兼容服务使用。",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "openai-web-search.js",
    "provider-failure.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "3.19.0",
    "ffi-rs": "1.3.7",
    "@silvia-odwyer/photon-node": "0.3.4"
  }
}
