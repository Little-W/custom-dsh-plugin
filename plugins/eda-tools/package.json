{
  "name": "@agent-studio/plugin-eda-tools",
  "version": "0.1.0",
  "type": "module",
  "description": "让智能体调用已配置的仿真、综合和其他 EDA 工具。",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "eda-mcp.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-atomic-write": "0.2.2-rc.1",
    "@deepseek-ai/dsh-mcp-client": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "3.19.0"
  }
}
