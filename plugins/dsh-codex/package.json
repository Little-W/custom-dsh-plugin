{
  "name": "@agent-studio/plugin-dsh-codex",
  "version": "0.1.7",
  "type": "module",
  "description": "Codex 编程提示、原生权限沙箱兼容编辑、并行检查、SVG 查看和搜索容错。",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "locale/*.json"
  ],
  "engines": {
    "dsh": ">=0.2.2-alpha.0 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "sharp": "0.35.5"
  }
}
