{
  "name": "@agent-studio/plugin-session-agent-loop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "会话暂停或意外中断后，可从原进度继续，已完成的工作会保留。",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@agent-studio/studio-core": "workspace:*"
  }
}
